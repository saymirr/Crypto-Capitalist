{
  "name": "crypto-capitalist-leaderboard",
  "version": "1.0.0",
  "private": true,
  "description": "Global leaderboard for Crypto Capitalist: a Cloudflare Worker + D1 that accepts wallet-signed scores.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "db:local": "wrangler d1 execute crypto-capitalist-leaderboard --local --file=schema.sql",
    "db:remote": "wrangler d1 execute crypto-capitalist-leaderboard --remote --file=schema.sql",
    "deploy": "wrangler deploy",
    "test": "node test/e2e.mjs"
  },
  "devDependencies": {
    "wrangler": "^4"
  },
  "engines": {
    "node": ">=22"
  }
}
